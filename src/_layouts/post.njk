---
layout: base
schema: blog
---

<article class="region blog" style="--region-space-top: var(--space-xl-2xl)">
  <div class="wrapper flow prose">
    <h1 class="gradient-text-linear">{{ title }}</h1>

    {% if image and showFeatured %}
      <!-- image -->
      {% image image, alt or title, credit, "eager", "popout" %}
    {% endif %}

    <p class="meta | cluster" style="--gutter: var(--space-xs-s)">
      <!-- date -->
      {% set definedDate = date %} {% include "partials/date.njk" %}
      {%
        if tags.length >
        1
      %}
        <!-- tags -->
        {% for tag in tags %}{% if tag != "posts" %}
          <a class="button post-tag" href="/tags/{{ tag }}"> {{ tag }} </a>
        {% endif %}{% endfor %}
      {% endif %}
    </p>

    {{ content | safe }}

    {% if videosGoogleDrive or videosYouTube %}
      <h2>Video</h2>
    {% endif %}

    <!-- google vidoes -->
    {% if videosGoogleDrive %}
      <div class="grid" data-layout="50-50">
        {% for video in videosGoogleDrive %}
          <custom-iframe @slug="{{ video.slug }}" @label="{{ video.label }}"></custom-iframe>
        {% endfor %}
      </div>
    {% endif %}

    <!-- youtube vidoes -->
    {% if videosYouTube %}
      <div class="grid" data-layout="50-50">
        {% for video in videosYouTube %}
          <custom-youtube @slug="{{ video.slug }}" @label="{{ video.label }}"> </custom-youtube>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!--  h-card infos: https://indieweb.org/authorship -->
  <div hidden class="h-entry">
    <a class="u-url" href="{{ page.url | url | absoluteUrl(meta.url) }}">{{ title }}</a>
    <a class="p-name u-url" rel="author" href="{{ meta.url }}">{{ meta.author.name }}</a>
    <img
      eleventy:ignore
      class="u-author h-card"
      src="{{ meta.author.avatar | url | absoluteUrl(meta.url) }}"
      alt="{{ meta.author.name }}"
    />
  </div>
</article>

{% css "inline" %}
  {% include "css/post.css" %}
{% endcss %}
