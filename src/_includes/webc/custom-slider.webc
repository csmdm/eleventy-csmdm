<is-land on:visible class="feature">
  <custom-slider class="flow" webc:root webc:keep>
    <slot></slot>

    <template data-island="once" webc:raw>
      <script src="/assets/scripts/components/custom-slider.js" type="module"></script>
    </template>
    <link rel="stylesheet" href="/assets/css/components/custom-slider.css" />
  </custom-slider>
</is-land>
